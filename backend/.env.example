# === Provider ===
# "vertex_ai" (default — use Vertex AI SDK via ADC / service account)
# "ai_studio"   (fallback — use GOOGLE_API_KEY for local dev)
LLM_PROVIDER=vertex_ai

# === Vertex AI settings (used when LLM_PROVIDER=vertex_ai) ===
# Google Cloud project ID. If unset, falls back to GOOGLE_CLOUD_PROJECT or ADC.
VERTEX_AI_PROJECT=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1

# === AI Studio fallback (used when LLM_PROVIDER=ai_studio) ===
# GOOGLE_API_KEY=your_gemini_api_key_here

# === Model ===
GEMINI_MODEL=gemini-3-flash-preview

# === MongoDB ===
# For local MongoDB — MCP bridge will skip automatically
# MONGODB_URI=mongodb://localhost:27017
# DATABASE_NAME=worldcup_2026

# For MongoDB Atlas — MCP bridge activates with full MCP tools
MONGODB_URI=mongodb+srv://user:pass@cluster.abcd1.mongodb.net/worldcup_2026
DATABASE_NAME=worldcup_2026
